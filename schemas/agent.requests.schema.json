{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redops.local/schemas/agent.requests.schema.json",
  "title": "AgentRequest",
  "description": "Задача для агента: tool + arguments от LLM",
  "type": "object",
  "required": [
    "id",
    "request_id",
    "correlation_id",
    "timestamp",
    "tool",
    "arguments",
    "mode"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Уникальный ID сообщения в agent.requests"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "description": "ID исходного orchestrator-запроса"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "description": "ID трассировки от бота"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "tool": {
      "type": "string",
      "enum": ["diagnose_auth", "setup_workstation"],
      "description": "Имя MCP-инструмента от LLM"
    },
    "arguments": {
      "type": "object",
      "description": "Параметры tool call от LLM",
      "additionalProperties": true
    },
    "mode": {
      "type": "string",
      "enum": ["dry-run", "execute"],
      "description": "Режим выполнения; по умолчанию dry-run"
    }
  }
}
