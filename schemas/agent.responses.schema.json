{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redops.local/schemas/agent.responses.schema.json",
  "title": "AgentResponse",
  "description": "Ответ агента на выполнение запроса",
  "type": "object",
  "required": ["id", "correlation_id", "agent_request_id", "timestamp", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_request_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["success", "error"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "success" } } },
      "then": { "required": ["payload"] }
    },
    {
      "if": { "properties": { "status": { "const": "error" } } },
      "then": { "required": ["error"] }
    }
  ]
}
