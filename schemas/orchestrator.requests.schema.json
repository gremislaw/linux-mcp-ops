{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redops.local/schemas/orchestrator.requests.schema.json",
  "title": "OrchestratorRequest",
  "description": "Запрос оркестратору на маршрутизацию к LLM и агенту",
  "type": "object",
  "required": ["id", "correlation_id", "timestamp", "intent", "text"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "intent": {
      "type": "string",
      "enum": ["execute", "tool_call", "query", "noop", "greeting", "info"],
      "description": "Намерение пользователя; execute/tool_call/query требуют действия"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "chat_id": {
      "type": "integer"
    },
    "user_id": {
      "type": "integer"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
