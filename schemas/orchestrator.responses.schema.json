{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redops.local/schemas/orchestrator.responses.schema.json",
  "title": "OrchestratorResponse",
  "description": "Итоговый ответ оркестратора для Telegram-бота",
  "type": "object",
  "required": [
    "id",
    "correlation_id",
    "orchestrator_request_id",
    "timestamp",
    "status",
    "chat_id",
    "text"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "orchestrator_request_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["success", "error", "timeout"]
    },
    "chat_id": {
      "type": "integer"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "Человекочитаемый текст для отправки в Telegram"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "description": "Опциональные структурированные данные для фронтенда"
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "error" } } },
      "then": { "required": ["error"] }
    },
    {
      "if": { "properties": { "status": { "const": "timeout" } } },
      "then": { "required": ["error"] }
    }
  ]
}
